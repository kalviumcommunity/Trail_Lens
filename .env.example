# TrialLens Environment Configuration
# Copy this file to .env and insert your API keys

# Google Gemini API Key (from https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/triallens?retryWrites=true&w=majority
MONGODB_DB_NAME=triallens

# Frontend API URL
VITE_API_URL=http://localhost:8000
